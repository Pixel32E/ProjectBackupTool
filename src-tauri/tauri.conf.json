{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectBackupTool",
  "version": "1.0.2",
  "identifier": "com.pixel32e.projectbackuptool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProjectBackupTool",
        "width": 1000,
        "height": 700,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "theme": "Light",
        "backgroundColor": "#EFE8E2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}